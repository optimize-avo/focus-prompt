# LLM Provider — set ONE API key for your chosen provider
# Model selection: FP_MODEL env var or --model flag (default: gpt-4o-mini)

# OpenAI
OPENAI_API_KEY=sk-your-key-here

# DeepSeek
# DEEPSEEK_API_KEY=sk-your-key-here

# MiniMax (Singapore endpoint — international)
# MINIMAX_API_KEY=your-key-here

# Qwen / Alibaba
# DASHSCOPE_API_KEY=your-key-here

# Zhipu / GLM
# ZAI_API_KEY=your-key-here

# Moonshot / Kimi
# MOONSHOT_API_KEY=your-key-here

# ByteDance / Doubao
# VOLCENGINE_API_KEY=your-key-here

# Tencent / Hunyuan
# TENCENT_API_KEY=your-key-here

# Xiaomi MiMo (Singapore endpoint)
# XIAOMI_MIMO_API_KEY=your-key-here

# Optional: override FP_MODEL to use a different provider
# FP_MODEL=minimax/MiniMax-M2.1
# FP_MODEL=deepseek/deepseek-chat
# FP_MODEL=dashscope/qwen-max
