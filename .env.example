# focus-prompt LLM Configuration
#
# RECOMMENDED: Use `fp setup` instead of this file.
#   fp setup    — saves to ~/.config/fp/config.env (per-user, works from any directory)
#
# ALTERNATIVE: Edit this file (project-level, legacy).
#   cp .env.example .env && edit .env
#   fp loads .env from current working directory automatically.
#
# OVERRIDE: Environment variables always win.
#   export FP_MODEL=minimax/MiniMax-M2.1
#   export MINIMAX_API_KEY=your-key-here

# ─── Step 1: Choose your model ────────────────────────────────
FP_MODEL=gpt-4o-mini
# FP_MODEL=minimax/MiniMax-M2.1
# FP_MODEL=xiaomi_mimo/MiMo-7B-RL
# FP_MODEL=deepseek/deepseek-chat
# FP_MODEL=dashscope/qwen-max
# FP_MODEL=zai/glm-4.7
# FP_MODEL=moonshot/moonshot-v1-8k
# FP_MODEL=volcengine/doubao-seed-1.6

# ─── Step 2: Set your API key (uncomment ONE) ─────────────────
# OpenAI (default)
OPENAI_API_KEY=sk-your-key-here
# DeepSeek
# DEEPSEEK_API_KEY=sk-your-key-here
# MiniMax (Singapore)
# MINIMAX_API_KEY=your-key-here
# Qwen / Alibaba
# DASHSCOPE_API_KEY=your-key-here
# Zhipu / GLM
# ZAI_API_KEY=your-key-here
# Moonshot / Kimi
# MOONSHOT_API_KEY=your-key-here
# ByteDance / Doubao
# VOLCENGINE_API_KEY=your-key-here
# Tencent / Hunyuan
# TENCENT_API_KEY=your-key-here
# Xiaomi MiMo (Singapore)
# XIAOMI_MIMO_API_KEY=your-key-here

# ─── Optional: web search (EXA) ──────────────────────────────
# EXA_API_KEY=your-exa-api-key-here

# ─── Optional: custom endpoints ────────────────────────────────
# MINIMAX_API_BASE=https://api.minimax.io/v1
# XIAOMI_MIMO_API_BASE=https://api.xiaomi.com/v1
